#!/bin/bash
set -e

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RESOURCES_DIR="$APP_ROOT/Resources"

PHP_PID_FILE="$RESOURCES_DIR/php/php-fpm.pid"
NGINX_PID_FILE="$RESOURCES_DIR/nginx/logs/nginx.pid"

is_running=0

if [ -f "$PHP_PID_FILE" ]; then
    PHP_PID="$(cat "$PHP_PID_FILE" 2>/dev/null || true)"
    if [ -n "$PHP_PID" ] && kill -0 "$PHP_PID" 2>/dev/null; then
        is_running=1
    fi
fi

if [ -f "$NGINX_PID_FILE" ]; then
    NGINX_PID="$(cat "$NGINX_PID_FILE" 2>/dev/null || true)"
    if [ -n "$NGINX_PID" ] && kill -0 "$NGINX_PID" 2>/dev/null; then
        is_running=1
    fi
fi

cd "$RESOURCES_DIR"

if [ "$is_running" -eq 1 ]; then
    exec /bin/bash "$RESOURCES_DIR/stop.sh"
else
    /bin/bash "$RESOURCES_DIR/start.sh"
    /usr/bin/open "http://127.0.0.1:8081"
fi